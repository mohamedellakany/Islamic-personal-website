[Unit]
Description=Dr. Moustafa Kamel Academy (gunicorn)
After=network.target

[Service]
User=__APP_USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=__APP_DIR__/.env
ExecStart=__APP_DIR__/.venv/bin/gunicorn --workers 2 --threads 2 --bind 127.0.0.1:8000 --access-logfile - academy.wsgi
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
