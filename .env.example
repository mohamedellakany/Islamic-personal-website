# Local settings for `bash dev.sh`. Copy to .env and fill in (.env is never committed).
# On Azure the same names go in App Service → Configuration (use deploy/cloudflare_live.sh).

# Cloudflare Stream live input (Stream → Live inputs → your input)
CF_STREAM_CUSTOMER=customer-xxxxxxxx.cloudflarestream.com
CF_LIVE_INPUT_ID=

# Optional, secret: only if Cloudflare's live status check asks for a token
CF_API_TOKEN=
